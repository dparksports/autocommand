<UserControl x:Class="AutoCommand.Views.BeMyGuestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Be My Guest" Style="{StaticResource PageHeader}"/>
            <TextBlock Text="Let an AI assistant read this machine's security telemetry — by explicit consent, revocable in one click."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,-12,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,15,20">

                <!-- Session -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Session" Style="{StaticResource SectionHeader}"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                            <Button x:Name="StartAgentBtn" Content="▶ Start AI session" Style="{StaticResource PrimaryButton}"
                                    Click="StartAgentBtn_Click" Margin="0,0,8,0"/>
                            <Button x:Name="StopAgentBtn" Content="⏹ Stop session" Style="{StaticResource PrimaryButton}"
                                    Click="StopAgentBtn_Click" Margin="0,0,12,0" IsEnabled="False"/>
                            <TextBlock x:Name="AgentStatusText" Text="Session off." VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <CheckBox x:Name="AgentAutostartCheck" Content="Start the session automatically whenever AutoCommand runs"
                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"
                                      Checked="AgentAutostartCheck_Changed" Unchecked="AgentAutostartCheck_Changed"/>
                            <CheckBox x:Name="AgentWakeCheck" Content="If AutoCommand isn't running, let my AI assistant open AutoCommand for me (Windows asks once; you start the session here in this tab)"
                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"
                                      Checked="AgentWakeCheck_Changed" Unchecked="AgentWakeCheck_Changed"/>
                            <TextBlock Text="Start a session only while you want an AI assistant (ZCode, Claude, …) to read this machine's security telemetry. The session listens on 127.0.0.1 only, is protected by a per-session token that never appears in any config file, and ends when you stop it, close AutoCommand, or its app exits. Read-only tools answer immediately; mutating requests (gates, Shields Up changes, telemetry opt-outs) ask on every action (a grant covers one target only). What the assistant reads can be repeated by the assistant — that is the consent you are giving. Honest boundary: the token sits in a local file while the session runs, so anything running as your user can read what the AI reads."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock Text="Auto-start keeps the consent above standing whenever the app runs. The background launch starts AutoCommand headless — read-only, no window, exits by itself after 30 minutes — and Windows shows one UAC approval for it; it can never request gates."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Connect an assistant -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Connect an assistant" Style="{StaticResource SectionHeader}"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                            <StackPanel x:Name="AgentClientsPanel" Orientation="Horizontal"/>
                            <Button x:Name="CopyAgentConfigBtn" Content="Copy MCP config" Click="CopyAgentConfigBtn_Click" Padding="10,2" Margin="0,0,8,0"/>
                            <Button x:Name="OpenAgentLogBtn" Content="Open activity log" Click="OpenAgentLogBtn_Click" Padding="10,2" Margin="0,0,12,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="Registration writes the 'autocommand' MCP entry into the client's config — the client spawns a small asInvoker proxy (never this elevated app), and the proxy forwards into the running session. Tools answer with setup guidance whenever no session is active here. Sessions are started only from this tab — there is no command-line activation; when AutoCommand is closed, the assistant can at most open the app for you (if you tick the wake option above), and you click Start."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- Activity -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Activity — every tool call, live" Style="{StaticResource SectionHeader}"/>

                        <ListBox Grid.Row="1" x:Name="AgentActivityList" Height="180" Margin="0,8,0,0" FontFamily="Consolas" FontSize="11"
                                 Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
