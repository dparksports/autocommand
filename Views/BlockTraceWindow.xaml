<Window x:Class="AutoCommand.Views.BlockTraceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Block Trace" Width="940" Height="760" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Block Trace" Style="{StaticResource PageHeader}"/>
            <TextBlock Text="The full provenance of one blocked target: the decision evidence captured when it was chosen, the blocks-events.log lifecycle, and every process instance that hit it since — svchost instances resolved to their hosted service, dead processes identified from the Sysmon archive."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,-8,0,0"/>
        </StackPanel>

        <!-- Status strip -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4"
                Padding="12,6" Margin="0,0,0,10">
            <TextBlock x:Name="StatusText" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap" Text="Composing the trace…"/>
        </Border>

        <!-- The report -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="ReportText" FontFamily="Consolas" FontSize="11"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap" Padding="4,0,4,12"/>
        </ScrollViewer>
    </Grid>
</Window>
