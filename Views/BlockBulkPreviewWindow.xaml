<Window x:Class="AutoCommand.Views.BlockBulkPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk block change — preview"
        WindowStartupLocation="CenterOwner" SizeToContent="Height" Width="680"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <!-- brighter muted gray than the app-wide TextSecondaryBrush - this
             sheet's secondary lines are small and dense -->
        
    </Window.Resources>
    <DockPanel Margin="16" LastChildFill="True">
        <TextBlock x:Name="HeadlineText" DockPanel.Dock="Top" FontSize="14" FontWeight="SemiBold"
                   TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock x:Name="SubText" DockPanel.Dock="Top" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,10"/>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <!-- Checked handlers are wired in code after InitializeComponent:
                 parsing IsChecked="True" would fire Checked while later
                 elements (RbExcept) are still null. -->
            <RadioButton x:Name="RbAll" GroupName="scope" IsChecked="True" FontSize="12" Margin="0,0,0,4"/>
            <RadioButton x:Name="RbExcept" GroupName="scope" FontSize="12" Margin="0,0,0,6"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CancelBtn" Content="Cancel" Click="CancelBtn_Click"
                    Padding="14,4" FontSize="12" Margin="0,0,8,0"/>
            <Button x:Name="ApplyBtn" Click="ApplyBtn_Click" Padding="14,4" FontSize="12"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>

        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="3" MaxHeight="260">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="GroupsLv"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
