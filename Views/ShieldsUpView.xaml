<UserControl x:Class="AutoCommand.Views.ShieldsUpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Status chips reuse the app's accent brushes; amber = open door,
             green = closed, red = needs attention (tamper, hijack). -->
        <SolidColorBrush x:Key="OkBrush" Color="#34D399"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#FBBF24"/>
        <SolidColorBrush x:Key="BadBrush" Color="#F87171"/>

        <!-- ═══ HIG detail-panel kit: large title, summary pill, inset
             groups, state rows, quiet action buttons. One vocabulary for
             every subtab: the page answers "am I OK?" in one glance
             (pill), rows lead with state, actions sit bottom-right,
             chrome recedes. ═══ -->
        <Style x:Key="LargeTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="SubIntro" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="8,2,0,4"/>
        </Style>
        <Style x:Key="InsetGroup" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <!-- One card per item: quiet by default, responds to hover so the
             row boundaries reveal themselves on contact (direct
             manipulation), never in static chrome. -->
        <Style x:Key="StatusRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="RowEvidence" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Quiet action: same control for the same action class on every
             subtab. Rounds, borders, dims when disabled, tints on hover. -->
        <Style x:Key="QuietBtn" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chrome" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource BorderBrush}" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chrome" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Summary pill: the page's whole verdict in one glance. -->
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Rail nav row: the checklist + the four rituals, one question per
             row. Mirrors the app-wide sidebar TabItem (indicator bar, nav
             brushes) sized for the inner rail. The header's Grid pins the
             status dot to the row's right edge in both rail states; padding
             tightens when the rail collapses so icon + dot still fit. -->
        <Style x:Key="RailItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="6,0,6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" Cursor="Hand">
                            <Grid>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                <Border x:Name="indicator" Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                        Margin="-12,-9,0,-9" Background="{DynamicResource TabIndicatorGradientBrush}"
                                        Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                                <Setter TargetName="indicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RailCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Padding" Value="6,9"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Rail labels and rail chrome hide when the rail collapses — the
             same pattern as MainWindow's NavPaneLabel / IsPaneCollapsed. -->
        <Style x:Key="RailLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RailCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RailExpand" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RailCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RailMeta" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RailCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The Shields Up rail: a NavigationView inside the sidebar. Left
             column = THE RITUAL header, the five nav rows, then a dot legend
             and the collapse toggle; right column = the intro line above the
             selected section. -->
        <Style x:Key="RailControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Width" Value="212"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RailCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Width" Value="56"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="12,10,10,6">
                                        <TextBlock Text="THE RITUAL" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Style="{StaticResource RailMeta}"/>
                                        <TextBlock Text="run top-down · one question per step" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                                   Margin="0,3,0,0" Style="{StaticResource RailMeta}"/>
                                    </StackPanel>

                                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,1,0,0" Padding="10,8">
                                        <StackPanel>
                                            <!-- dot legend: the same language as the checklist chips -->
                                            <StackPanel Style="{StaticResource RailMeta}">
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="closed / done" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentAmberBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="open / not set" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentRedBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="needs attention" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Click="RailCollapseBtn_Click" HorizontalAlignment="Stretch" Padding="8,5"
                                                    FontSize="11" Margin="0,8,0,0" ToolTip="Show / hide rail labels">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="«  Collapse" Style="{StaticResource RailLabel}"/>
                                                    <TextBlock Text="»" Style="{StaticResource RailExpand}"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" Margin="0,4,0,0"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource BackgroundBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                               Margin="4,2,8,10"
                                               Text="The fresh-install ritual, folded into AutoCommand: close the doors Windows leaves open, silence the phone-home, take the junk out, and set the OS switches. Every action asks first, almost every action reverses. The firewall profile lives in the Firewall tab. The dots on the rail mirror each section's live state."/>
                                    <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16,24,12">
        <TabControl x:Name="SubTabs" Style="{StaticResource RailControl}"
                    SelectionChanged="SubTabs_SelectionChanged">

            <!-- ═══════════ QUICK SCAN ═══════════ -->
            <TabItem Style="{StaticResource RailItem}">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="✅" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Quick Scan" Margin="9,0,0,0" Style="{StaticResource RailLabel}"/>
                        <Ellipse x:Name="QuickScanDot" Grid.Column="1" Width="8" Height="8" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" Fill="Gray" ToolTip="Not checked yet"/>
                    </Grid>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Left" Margin="4,10,4,8">

                        <!-- ── migration banner (visible only when the standalone app left state) ── -->
                        <Border x:Name="MigrationBanner" Visibility="Collapsed" CornerRadius="12"
                                Background="{DynamicResource BadgeAmberBg}" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="MigrationText" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="ImportBtn" Content="Import Shields Up state"
                                            Click="ImportBtn_Click" Padding="12,5"/>
                                    <TextBlock x:Name="MigrationResultText" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource LargeTitle}" Text="Quick Scan"/>
                                <TextBlock Style="{StaticResource SubIntro}" Margin="0,4,0,0"
                                           Text="The whole ritual as one checklist — reads your machine first, then finishes the rest in order."/>
                            </StackPanel>
                            <Border Style="{StaticResource Pill}" Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="QuickScanPillDot" Width="8" Height="8" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="QuickScanPillText" FontSize="12" Margin="7,0,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Text="Not checked yet"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{DynamicResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="QuickScanBtn" Style="{DynamicResource PrimaryButton}"
                                            Content="Run Quick Scan" Click="QuickScanBtn_Click"/>
                                    <Button x:Name="QuickScanCheckBtn" Style="{StaticResource QuietBtn}" Content="Re-check status" Margin="10,0,0,0"
                                            Click="QuickScanCheckBtn_Click"/>
                                </StackPanel>
                                <ItemsControl x:Name="QuickScanList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="300"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Chip}" FontSize="13" VerticalAlignment="Top"
                                                               Foreground="{Binding ChipBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource RowTitle}"
                                                               TextWrapping="Wrap" VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource RowEvidence}"
                                                               VerticalAlignment="Top"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="QuickScanProgress" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="Collapsed" Margin="8,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════ DOORS ═══════════ -->
            <TabItem Style="{StaticResource RailItem}">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🚪" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Doors" Margin="9,0,0,0" Style="{StaticResource RailLabel}"/>
                        <Ellipse x:Name="DoorsDot" Grid.Column="1" Width="8" Height="8" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" Fill="Gray" ToolTip="Not checked yet"/>
                    </Grid>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Left" Margin="4,10,4,8">

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource LargeTitle}" Text="Doors"/>
                                <TextBlock Style="{StaticResource SubIntro}" Margin="0,4,0,0"
                                           Text="Entry points Windows leaves open by default. Every action asks first; every action reverses."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Border Style="{StaticResource Pill}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="DoorsPillDot" Width="8" Height="8" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DoorsPillText" FontSize="12" Margin="7,0,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Text="Not checked yet"/>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="DoorsRefreshBtn" Style="{StaticResource QuietBtn}" Content="⟳ Re-check" VerticalAlignment="Center"
                                        Click="DoorsRefreshBtn_Click"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource GroupHeader}" Text="REMOTE ACCESS"/>
                        <Border Style="{StaticResource InsetGroup}">
                            <StackPanel>
                                <Border Style="{StaticResource StatusRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource RowTitle}" Text="SSTP VPN service &amp; miniports"/>
                                            <TextBlock x:Name="SstpStatusText" Style="{StaticResource RowEvidence}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="SstpToggleBtn" Grid.Column="1" Style="{StaticResource QuietBtn}" Content="Disable + neuter miniports"
                                                VerticalAlignment="Center" Margin="12,0,0,0" Click="SstpToggleBtn_Click"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource StatusRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource RowTitle}" Text="Wi-Fi Direct ghost hotspot"/>
                                            <TextBlock x:Name="HostedNetworkStatusText" Style="{StaticResource RowEvidence}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="HostedStopBtn" Style="{StaticResource QuietBtn}" Content="Stop &amp; disallow"
                                                    Margin="12,0,0,0" Click="HostedStopBtn_Click"/>
                                            <Button x:Name="WifiDirectRemoveBtn" Style="{StaticResource QuietBtn}" Content="Remove adapter(s)" Margin="8,0,0,0"
                                                    Click="WifiDirectRemoveBtn_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource StatusRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource RowTitle}" Text="Kernel debug (KDNET)"/>
                                            <TextBlock x:Name="KdnetStatusText" Style="{StaticResource RowEvidence}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="KdnetToggleBtn" Grid.Column="1" Style="{StaticResource QuietBtn}" Content="Turn debug off"
                                                VerticalAlignment="Center" Margin="12,0,0,0" Click="KdnetToggleBtn_Click"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource StatusRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource RowTitle}" Text="Windows VPN services (RasMan, IKEEXT, PolicyAgent, RemoteAccess)"/>
                                            <TextBlock x:Name="VpnStatusText" Style="{StaticResource RowEvidence}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="VpnDisableBtn" Style="{StaticResource QuietBtn}" Content="Disable all"
                                                    Margin="12,0,0,0" Click="VpnDisableBtn_Click"/>
                                            <Button x:Name="VpnEnableBtn" Style="{StaticResource QuietBtn}" Content="Re-enable" Margin="8,0,0,0"
                                                    Click="VpnEnableBtn_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource StatusRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource RowTitle}" Text="WAN Miniport adapters"/>
                                            <TextBlock x:Name="MiniportStatusText" Style="{StaticResource RowEvidence}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="MiniportRemoveBtn" Grid.Column="1" Style="{StaticResource QuietBtn}" Content="Remove all"
                                                VerticalAlignment="Center" Margin="12,0,0,0" Click="MiniportRemoveBtn_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource GroupHeader}" Text="LEGACY NAME RESOLUTION"/>
                        <Border Style="{StaticResource InsetGroup}">
                            <StackPanel>
                                <Border Style="{StaticResource StatusRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource RowTitle}" Text="LLMNR · UDP 5355"/>
                                            <TextBlock x:Name="LlmnrStatusText" Style="{StaticResource RowEvidence}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="LlmnrToggleBtn" Grid.Column="1" Style="{StaticResource QuietBtn}" Content="Disable LLMNR"
                                                VerticalAlignment="Center" Margin="12,0,0,0" Click="LlmnrToggleBtn_Click"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource StatusRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource RowTitle}" Text="NetBIOS name resolution · UDP 137"/>
                                            <TextBlock x:Name="NbnsStatusText" Style="{StaticResource RowEvidence}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="NbnsToggleBtn" Grid.Column="1" Style="{StaticResource QuietBtn}" Content="Disable NetBIOS"
                                                VerticalAlignment="Center" Margin="12,0,0,0" Click="NbnsToggleBtn_Click"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource StatusRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource RowTitle}" Text="mDNS · UDP 5353"/>
                                            <TextBlock x:Name="MdnsStatusText" Style="{StaticResource RowEvidence}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="MdnsToggleBtn" Grid.Column="1" Style="{StaticResource QuietBtn}" Content="Block mDNS"
                                                VerticalAlignment="Center" Margin="12,0,0,0" Click="MdnsToggleBtn_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="DoorActionResult" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Visibility="Collapsed" Margin="8,0,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════ PRIVACY ═══════════ -->
            <TabItem Style="{StaticResource RailItem}">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔕" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Privacy" Margin="9,0,0,0" Style="{StaticResource RailLabel}"/>
                        <Ellipse x:Name="PrivacyDot" Grid.Column="1" Width="8" Height="8" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" Fill="Gray" ToolTip="Not checked yet"/>
                    </Grid>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Left" Margin="4,10,4,8">

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource LargeTitle}" Text="Privacy"/>
                                <TextBlock Style="{StaticResource SubIntro}" Margin="0,4,0,0"
                                           Text="Each vendor's own opt-out switch, saved and reversible. Feature rules reduce at the source — only a firewall block proves zero bytes."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Border Style="{StaticResource Pill}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="PrivacyPillDot" Width="8" Height="8" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="PrivacyPillText" FontSize="12" Margin="7,0,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Text="Not checked yet"/>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="TelemetryRefreshBtn" Style="{StaticResource QuietBtn}" Content="⟳ Re-check" VerticalAlignment="Center"
                                        Click="TelemetryRefreshBtn_Click"/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{DynamicResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="TelemetryEnforceAllBtn" Style="{StaticResource QuietBtn}" Content="Pin remaining (hosts backstop)"
                                            Click="TelemetryEnforceAllBtn_Click"/>
                                </StackPanel>
                                <ItemsControl x:Name="TelemetryList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding AppName}" Style="{StaticResource RowTitle}"/>
                                                            <TextBlock Text="{Binding StateText}" FontSize="12" Margin="10,0,0,0"
                                                                       Foreground="{Binding StateBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Evidence}" Style="{StaticResource RowEvidence}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource QuietBtn}" Content="Opt out" Visibility="{Binding OptOutVis}"
                                                                Click="TelemetryOptOut_Click" Tag="{Binding}"/>
                                                        <Button Style="{StaticResource QuietBtn}" Content="Revert" Margin="8,0,0,0" Visibility="{Binding RevertVis}"
                                                                Click="TelemetryRevert_Click" Tag="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="TelemetryResultText" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="8,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════ JUNK ═══════════ -->
            <TabItem Style="{StaticResource RailItem}">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🧹" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Junk" Margin="9,0,0,0" Style="{StaticResource RailLabel}"/>
                        <Ellipse x:Name="JunkDot" Grid.Column="1" Width="8" Height="8" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" Fill="Gray" ToolTip="Not checked yet"/>
                    </Grid>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Left" Margin="4,10,4,8">

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource LargeTitle}" Text="Junk"/>
                                <TextBlock Style="{StaticResource SubIntro}" Margin="0,4,0,0"
                                           Text="Preinstalled apps — games, trial apps, the ones that come back with the update. Nothing Windows needs is ever on the list."/>
                            </StackPanel>
                            <Border Style="{StaticResource Pill}" Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="JunkPillDot" Width="8" Height="8" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="JunkPillText" FontSize="12" Margin="7,0,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Text="Not scanned yet"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{DynamicResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="BloatRefreshBtn" Style="{StaticResource QuietBtn}" Content="Scan for bloatware"
                                            Click="BloatRefreshBtn_Click"/>
                                    <Button x:Name="BloatRemoveBtn" Style="{StaticResource QuietBtn}" Content="Remove matched apps" Margin="10,0,0,0"
                                            Click="BloatRemoveBtn_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="BloatListText" Style="{StaticResource RowEvidence}" Text="Not scanned yet."/>
                                <TextBlock x:Name="BloatResultText" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="8,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════ HARDENING ═══════════ -->
            <TabItem Style="{StaticResource RailItem}">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔐" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Hardening" Margin="9,0,0,0" Style="{StaticResource RailLabel}"/>
                        <Ellipse x:Name="HardeningDot" Grid.Column="1" Width="8" Height="8" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" Fill="Gray" ToolTip="Not checked yet"/>
                    </Grid>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Left" Margin="4,10,4,8">

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource LargeTitle}" Text="Hardening"/>
                                <TextBlock Style="{StaticResource SubIntro}" Margin="0,4,0,0"
                                           Text="Registry-level OS switches, each reversible. Reboot after changing IPv6 or LSA."/>
                            </StackPanel>
                            <Border Style="{StaticResource Pill}" Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="HardeningPillDot" Width="8" Height="8" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HardeningPillText" FontSize="12" Margin="7,0,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Text="Not checked yet"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Style="{StaticResource GroupHeader}" Text="NETWORK"/>
                        <Border Style="{StaticResource InsetGroup}">
                            <Border Style="{StaticResource StatusRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowTitle}" Text="IPv6 (global DisabledComponents)"/>
                                        <TextBlock x:Name="Ipv6StatusText" Style="{StaticResource RowEvidence}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="Ipv6Btn" Grid.Column="1" Style="{StaticResource QuietBtn}" Content="Disable"
                                            VerticalAlignment="Center" Margin="12,0,0,0" Click="Ipv6Btn_Click"/>
                                </Grid>
                            </Border>
                        </Border>

                        <TextBlock Style="{StaticResource GroupHeader}" Text="SIGN-IN"/>
                        <Border Style="{StaticResource InsetGroup}">
                            <StackPanel>
                                <Border Style="{StaticResource StatusRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource RowTitle}" Text="LSA Protection (RunAsPPL)"/>
                                            <TextBlock x:Name="LsaStatusText" Style="{StaticResource RowEvidence}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="LsaBtn" Grid.Column="1" Style="{StaticResource QuietBtn}" Content="Enable"
                                                VerticalAlignment="Center" Margin="12,0,0,0" Click="LsaBtn_Click"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource StatusRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource RowTitle}" Text="UAC strictness"/>
                                            <TextBlock x:Name="UacStatusText" Style="{StaticResource RowEvidence}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="UacBtn" Grid.Column="1" Style="{StaticResource QuietBtn}" Content="Set maximum"
                                                VerticalAlignment="Center" Margin="12,0,0,0" Click="UacBtn_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource GroupHeader}" Text="HOSTS FILE"/>
                        <Border Style="{StaticResource InsetGroup}">
                            <Border Style="{StaticResource StatusRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Hosts file"/>
                                        <TextBlock x:Name="HostsStatusText" Style="{StaticResource RowEvidence}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="HostsResetBtn" Grid.Column="1" Style="{StaticResource QuietBtn}" Content="Reset to default"
                                            VerticalAlignment="Center" Margin="12,0,0,0" Click="HostsResetBtn_Click"/>
                                </Grid>
                            </Border>
                        </Border>

                        <TextBlock x:Name="HardeningActionResult" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Visibility="Collapsed" Margin="8,0,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
