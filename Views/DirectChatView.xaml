<UserControl x:Class="AutoCommand.Views.DirectChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Ask AutoCommand" Style="{StaticResource PageHeader}"/>
            <TextBlock Text="Converse with AutoCommand directly — GLM answers in plain English and can read this machine's live telemetry through the same tools the AI bridge serves."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,-12,0,0"/>
        </StackPanel>

        <!-- First-run setup: consent + key. Collapses the moment both exist. -->
        <Border Grid.Row="1" x:Name="SetupCard" Style="{StaticResource CardPanel}" Margin="0,0,15,12"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Enable direct chat" Style="{StaticResource SectionHeader}"/>
                <TextBlock x:Name="SetupMissingText" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,8"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="EnableChatBtn" Content="Enable &amp; set up…" Style="{StaticResource PrimaryButton}"
                            Click="EnableChatBtn_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Settings (collapsed until opened): endpoint, model, key, mutator toggle -->
        <Expander Grid.Row="2" x:Name="SettingsExpander" Margin="0,0,15,12" Foreground="{DynamicResource TextPrimaryBrush}">
            <Expander.Header>
                <TextBlock Text="Chat settings" FontWeight="SemiBold"/>
            </Expander.Header>
            <Border Style="{StaticResource CardPanel}" Margin="0,4,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                        <TextBlock Text="Endpoint" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="EndpointCombo" Width="300" SelectionChanged="EndpointCombo_SelectionChanged">
                            <ComboBoxItem Tag="coding" Content="Z.ai Coding Plan (glm-5.3-flash included)"/>
                            <ComboBoxItem Tag="standard" Content="Z.ai standard API (pay-as-you-go)"/>
                            <ComboBoxItem Tag="bigmodel" Content="Zhipu BigModel (mainland)"/>
                            <ComboBoxItem Tag="custom" Content="Custom base URL…"/>
                        </ComboBox>
                        <TextBox x:Name="CustomUrlBox" Width="280" Margin="8,0,0,0" VerticalAlignment="Center"
                                 FontSize="11" Visibility="Collapsed"
                                 LostFocus="CustomUrlBox_LostFocus"
                                 ToolTip="Custom OpenAI-compatible base URL, e.g. https://example.com/api/paas/v4"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Model" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="ModelBox" Width="180" FontSize="11" VerticalAlignment="Center"
                                 LostFocus="ModelBox_LostFocus"/>
                        <TextBlock x:Name="KeyStateText" VerticalAlignment="Center" Margin="16,0,8,0" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <PasswordBox x:Name="KeyBox" Width="280" FontSize="11" VerticalAlignment="Center"
                                     ToolTip="Your Z.ai API key — stored DPAPI-encrypted on this machine, never in a settings file"/>
                        <Button x:Name="SaveKeyBtn" Content="Save key" Style="{StaticResource PrimaryButton}"
                                Click="SaveKeyBtn_Click" Margin="8,0,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="AllowMutatingCheck" Margin="0,2,0,4"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Checked="AllowMutatingCheck_Changed" Unchecked="AllowMutatingCheck_Changed"
                              Content="Allow AutoCommand changes from chat (gates, Shields Up presets) — every change still asks here in the app before it runs"/>
                    <TextBlock Text="Off, the model is not even told that changing tools exist. On, each change pops the same confirmation dialog the AI bridge uses (with 'always for this session' grants, per target). Conversation text and tool answers leave this machine for the model endpoint — that is the consent you gave under 'Enable'. Every request and tool call lands in the activity log."
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="ClearChatBtn" Content="Clear conversation" Padding="10,2"
                                Click="ClearChatBtn_Click"
                                ToolTip="Wipes the in-memory transcript and resets 'always for this session' grants. Nothing was ever written to disk."/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Expander>

        <!-- Transcript -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                Margin="0,0,15,8">
            <ScrollViewer x:Name="TranscriptScroller" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="10,8">
                <ItemsControl x:Name="ChatList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3" HorizontalAlignment="Stretch">
                                <!-- user: right, accent border -->
                                <Border HorizontalAlignment="Right" MaxWidth="520" CornerRadius="10" Padding="10,6"
                                        Background="{DynamicResource SurfaceBrush}" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Border>
                                <!-- assistant: left, plain border -->
                                <Border HorizontalAlignment="Left" MaxWidth="660" CornerRadius="10" Padding="10,6"
                                        Background="{DynamicResource SurfaceBrush}" BorderThickness="1"
                                        BorderBrush="{DynamicResource BorderBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Border>
                                <!-- tool chip: small mono line -->
                                <Border HorizontalAlignment="Left" CornerRadius="6" Padding="8,3" Margin="6,0,0,0"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTool}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ToolLine}" FontFamily="Consolas" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Input -->
        <Grid Grid.Row="4" Margin="0,0,15,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Grid.Column="0" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" MaxHeight="110" FontSize="12"
                     VerticalContentAlignment="Top" MinHeight="34"
                     PreviewKeyDown="InputBox_PreviewKeyDown"/>
            <Button x:Name="SendBtn" Grid.Column="1" Content="Send ⏎" Style="{StaticResource PrimaryButton}"
                    Click="SendBtn_Click" Margin="8,0,0,0" VerticalAlignment="Bottom" MinHeight="34"/>
            <Button x:Name="StopBtn" Grid.Column="2" Content="⏹ Stop" Style="{StaticResource PrimaryButton}"
                    Click="StopBtn_Click" Margin="8,0,0,0" VerticalAlignment="Bottom" MinHeight="34" IsEnabled="False"/>
        </Grid>

        <TextBlock Grid.Row="5" x:Name="ChatStatusText" Margin="0,0,15,0" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                   Text="Not set up — enable direct chat above."/>
    </Grid>
</UserControl>
