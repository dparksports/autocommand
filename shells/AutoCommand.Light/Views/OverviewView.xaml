<UserControl x:Class="AutoCommand.Light.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="780" HorizontalAlignment="Left" Margin="28,24,28,24">

            <TextBlock Text="Overview" Style="{StaticResource PageHeader}"/>
            <TextBlock Text="What your PC has been doing — in plain words."
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,18"/>

            <!-- first-run card: the invitation -->
            <Border x:Name="WatchCard" Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Let's take five minutes"/>
                    <TextBlock Text="AutoCommand is already watching. Give it five minutes and it will tell you, in plain words, what your PC did — and whether anything looks wrong."
                               TextWrapping="Wrap" Margin="0,6,0,10"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="CountdownText" Text="Report ready in 5:00"
                               FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Button Content="Show me now" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Click="ShowNowBtn_Click"/>
                </StackPanel>
            </Border>

            <!-- the report -->
            <Border x:Name="ReportPanel" Style="{StaticResource CardPanel}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="HeadlineText" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel x:Name="ReportLinesPanel"/>
                    <Border x:Name="TipPanel" Background="{StaticResource BadgeBlueBg}" CornerRadius="8"
                            Padding="12,10" Margin="0,14,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TipText" TextWrapping="Wrap" MaxWidth="430"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="SysmonBtn" Content="Set up Sysmon" Style="{StaticResource PrimaryButton}"
                                    FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center"
                                    Click="SysmonBtn_Click"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Refresh" Style="{StaticResource QuietButton}" FontSize="12"
                            HorizontalAlignment="Left" Margin="0,16,0,0" Click="RefreshBtn_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
