<UserControl x:Class="AutoCommand.Light.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AutoCommand.Light.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="780" HorizontalAlignment="Left" Margin="32,28,32,28">

            <TextBlock Text="Settings" Style="{StaticResource PageHeader}"/>
            <TextBlock Text="One switch that matters, your data, and the truth about what this app will and will not do."
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,18"/>

            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Appearance"/>
                    <TextBlock Text="Dark is what first-run teaches. Pick either — it applies right now and sticks."
                               TextWrapping="Wrap" Margin="0,4,0,10"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <controls:Segmented x:Name="ThemeSegment" Width="280" HorizontalAlignment="Left"
                                        ValueChanged="ThemeSegment_ValueChanged"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="The gate"/>
                    <TextBlock x:Name="GateStateText" Margin="0,6,0,10" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="OpenBtn" Content="Open the internet for everyone — 10 minutes"
                                Style="{StaticResource QuietButton}" FontSize="13"
                                HorizontalAlignment="Left" Click="OpenBtn_Click"
                                ToolTip="Pauses every block — Light's and the Advanced app's. The gate stands down until the ten minutes end."/>
                        <Button x:Name="CloseBtn" Content="Close it now" Style="{StaticResource PrimaryButton}"
                                FontSize="13" Margin="10,0,0,0" Click="CloseBtn_Click" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Your data"/>
                    <TextBlock Text="The gate's decisions, its history and this app's preferences live in one folder on this PC — plain files you can read. Nothing is stored anywhere else."
                               TextWrapping="Wrap" Margin="0,4,0,10"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Content="Open my data folder" Style="{StaticResource QuietButton}"
                            HorizontalAlignment="Left" FontSize="13" Click="OpenData_Click"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="What this app does — and never does"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20">
                        It keeps the internet closed: your browser talks, everything new asks first, and you decide who stays.<LineBreak/>
                        It never deletes anything, never edits Windows settings silently, and never sends your data anywhere.<LineBreak/>
                        Windows' own essentials keep working — they are shown, not hidden.<LineBreak/>
                        It repairs its own leftovers after a crash — and tells you when it did.
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Need more power?"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,10"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        The Advanced app (AutoCommand) adds deep forensics, site diagnosis, an AI-assistant bridge and
                        full firewall control — same blocks, same undo, same 🚑. Either app's panic button pauses
                        both, so they are safe side by side.
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                               Text="Everything here is computed on this PC. Light collects nothing and phones no one."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
