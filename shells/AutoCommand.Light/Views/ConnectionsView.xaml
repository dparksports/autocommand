<UserControl x:Class="AutoCommand.Light.Views.ConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Connections" Style="{StaticResource PageHeader}"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="Every program talking to the internet, labeled in plain words."
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                <TextBlock x:Name="SysmonChip" Text="Sysmon: checking…"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="RowsGrid" Grid.Row="1"
                  ContextMenuOpening="RowsGrid_ContextMenuOpening">
            <DataGrid.Columns>
                <DataGridTextColumn Header=" " Binding="{Binding Glyph}" Width="30"/>
                <DataGridTextColumn Header="Program" Binding="{Binding Program}" Width="150"/>
                <DataGridTextColumn Header="What it is" Binding="{Binding Chip}" Width="180">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding ChipDetail}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Website" Binding="{Binding Website}" Width="220"/>
                <DataGridTextColumn Header="Address" Binding="{Binding Ip}" Width="130"/>
                <DataGridTextColumn Header="Blocked attempts" Binding="{Binding Attempts}" Width="110"/>
                <DataGridTextColumn Header="Sent" Binding="{Binding Out}" Width="90"/>
                <DataGridTextColumn Header="Received" Binding="{Binding In}" Width="*"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Block this program" Click="BlockProgram_Click"/>
                    <MenuItem Header="Block this address" Click="BlockAddress_Click"/>
                    <MenuItem Header="Unblock — traffic resumes" Click="Unblock_Click"/>
                    <Separator/>
                    <MenuItem Header="Ignore this program (stop listing it)" Click="Ignore_Click"/>
                    <MenuItem Header="Copy address" Click="CopyAddress_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</UserControl>
