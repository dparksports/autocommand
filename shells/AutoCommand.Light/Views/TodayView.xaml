<UserControl x:Class="AutoCommand.Light.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="32,28,32,28">

            <TextBlock x:Name="DateText" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
            <TextBlock x:Name="HeadlineText" FontSize="32" FontWeight="SemiBold" Margin="0,6,0,6"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="SublineText" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>

            <!-- the asks banner: apps waiting for an answer -->
            <Border x:Name="AsksBanner" Background="{DynamicResource BadgeAmberBg}" CornerRadius="10"
                    Padding="16,12" Margin="0,18,0,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="AsksText" TextWrapping="Wrap" MaxWidth="470"
                               VerticalAlignment="Center"/>
                    <Button Content="Review" Style="{StaticResource PrimaryButton}" FontSize="12"
                            Margin="16,0,0,0" VerticalAlignment="Center" Click="ReviewBtn_Click"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Stopped attempts today"/>
                    <TextBlock x:Name="AttemptsEmpty" FontSize="13" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="None. Nothing reached for the internet behind your back today."/>
                    <StackPanel x:Name="AttemptsList" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="The day, hour by hour"/>
                    <ItemsControl x:Name="Hours" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Rectangle Width="14" Margin="2,0"
                                           VerticalAlignment="Bottom"
                                           Fill="{Binding Brush}" Height="{Binding Height}"
                                           RadiusX="3" RadiusY="3"
                                           ToolTip="{Binding Label}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontSize="11" Margin="2,8,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="Midnight → midnight, local time"/>
                </StackPanel>
            </Border>

            <Button Content="Refresh" Style="{StaticResource QuietButton}" FontSize="12"
                    HorizontalAlignment="Left" Margin="0,16,0,0" Click="RefreshBtn_Click"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
