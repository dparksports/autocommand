<UserControl x:Class="AutoCommand.Light.Views.AttemptsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Attempts" Style="{StaticResource PageHeader}"/>
            <TextBlock Text="Every reach for the internet the gate held — and everything this app did, in sentences."
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <Button x:Name="RefreshBtn" Grid.Row="1" Content="Refresh" Style="{StaticResource QuietButton}"
                FontSize="12" HorizontalAlignment="Left" Margin="0,0,0,12" Click="RefreshBtn_Click"/>

        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="Today's held attempts"/>
                <TextBlock x:Name="AttemptsEmpty" FontSize="13" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                           Text="None so far."/>
                <StackPanel x:Name="AttemptsList" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <ListBox x:Name="IncidentList" Grid.Row="3"
                 Background="{DynamicResource SurfaceBrush}"
                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="8,5">
                        <TextBlock Text="{Binding When}" FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding Sentence}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
