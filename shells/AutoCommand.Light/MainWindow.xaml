<Window x:Class="AutoCommand.Light.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AutoCommand.Light.Views"
        x:Name="RootWindow"
        Title="AutoCommand Light"
        Height="720" Width="1080"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" Grid.Row="0" TabStripPlacement="Left" SelectedIndex="0">

            <TabItem x:Name="OverviewNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏠" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Overview" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:OverviewView x:Name="OverviewTab"/>
            </TabItem>

            <TabItem x:Name="ConnectionsNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Connections" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:ConnectionsView x:Name="ConnectionsTab"/>
            </TabItem>

            <TabItem x:Name="BlocksNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⛔" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Blocks" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:BlocksView x:Name="BlocksTab"/>
            </TabItem>

            <TabItem x:Name="HistoryNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧾" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="History" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:HistoryView x:Name="HistoryTab"/>
            </TabItem>

            <TabItem x:Name="AskNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💬" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Ask" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:AskView x:Name="AskTab"/>
            </TabItem>

            <TabItem x:Name="SettingsNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Settings" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:SettingsView x:Name="SettingsTab"/>
            </TabItem>
        </TabControl>

        <!-- Status bar: state on the left, the panic button always on the
             right — the safety net is never more than one click away. -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="WatchDot" Width="8" Height="8"
                             Fill="{StaticResource AccentGreenBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="WatchText" Text="watching live"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" Text="AutoCommand Light"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button x:Name="RestoreInternetBtn" Content="🚑 Restore Internet"
                            Style="{StaticResource DangerButton}" FontSize="12"
                            ToolTip="Blocked something and lost connectivity? Pauses ALL blocks — Advanced's and Light's — in one click. Nothing is deleted."
                            Click="RestoreInternetBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
