<Window x:Class="AutoCommand.Light.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AutoCommand.Light.Views"
        x:Name="RootWindow"
        Title="AutoCommand Light"
        Background="{DynamicResource BackgroundBrush}"
        Height="720" Width="1040"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" Grid.Row="0" TabStripPlacement="Left" SelectedIndex="0"
                Background="{DynamicResource BackgroundBrush}" BorderThickness="0">

            <TabItem x:Name="TodayNavItem" Style="{StaticResource NavItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛡" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Today" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:TodayView x:Name="TodayTab"/>
            </TabItem>

            <TabItem x:Name="AppsNavItem" Style="{StaticResource NavItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧩" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Apps" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:AppsView x:Name="AppsTab"/>
            </TabItem>

            <TabItem x:Name="AttemptsNavItem" Style="{StaticResource NavItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧾" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Attempts" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:AttemptsView x:Name="AttemptsTab"/>
            </TabItem>

            <TabItem x:Name="HelpNavItem" Style="{StaticResource NavItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💬" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Help" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:HelpView x:Name="HelpTab"/>
            </TabItem>

            <TabItem x:Name="SettingsNavItem" Style="{StaticResource NavItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Settings" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:SettingsView x:Name="SettingsTab"/>
            </TabItem>
        </TabControl>

        <!-- the panic action lives where the eyes already are: bottom-right -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="GateDot" Width="8" Height="8"
                             Fill="{DynamicResource AccentGreenBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="GateText" Text="gate is up — only your browser and allowed apps talk"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" Text="AutoCommand Light"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button x:Name="OpenBtn" Content="🚑 Open the internet — 10 min"
                            Style="{StaticResource DangerButton}" FontSize="12"
                            ToolTip="If anything ever stops working: pauses EVERY block for ten minutes. Nothing is deleted, and it closes itself."
                            Click="OpenBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- onboarding: three sentences, one choice at the end. Shown once,
             over a dimmed app — the Tracking-Transparency discipline. -->
        <Grid x:Name="Onboarding" Grid.Row="0" Background="#CC1B2733" Visibility="Collapsed">
            <Border Width="520" Background="{DynamicResource SurfaceBrush}" CornerRadius="16"
                    Padding="32,28" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <StackPanel x:Name="OnbStep1">
                        <TextBlock FontSize="24" FontWeight="SemiBold"
                                   Text="This app keeps your internet closed." TextWrapping="Wrap"/>
                        <TextBlock FontSize="14" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Your browser stays open. Everything else asks first — and you decide who stays."/>
                    </StackPanel>
                    <StackPanel x:Name="OnbStep2" Visibility="Collapsed">
                        <TextBlock FontSize="24" FontWeight="SemiBold"
                                   Text="When something wants to talk, you'll see one question." TextWrapping="Wrap"/>
                        <TextBlock FontSize="14" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Allow once, always, or never — and you can change your mind any time on the Apps page."/>
                    </StackPanel>
                    <!-- the snapshot: what was running before the gate closed,
                         offered as bulk triage so existing workflows are
                         never the surprise -->
                    <StackPanel x:Name="OnbStepSnap" Visibility="Collapsed">
                        <TextBlock FontSize="24" FontWeight="SemiBold"
                                   Text="These were running before I started." TextWrapping="Wrap"/>
                        <TextBlock FontSize="14" Margin="0,12,0,6" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="They are held and asking. Check any you trust to talk:"/>
                        <StackPanel x:Name="SnapList" MaxHeight="220"/>
                        <TextBlock x:Name="SnapEmpty" FontSize="13" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="No unknown apps were running — nothing to decide."
                                   Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel x:Name="OnbStep3" Visibility="Collapsed">
                        <TextBlock FontSize="24" FontWeight="SemiBold"
                                   Text="If anything ever stops working, one button opens everything." TextWrapping="Wrap"/>
                        <TextBlock FontSize="14" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="🚑 sits at the bottom right, nothing is deleted, and it closes itself after ten minutes."/>
                    </StackPanel>
                    <Button x:Name="OnbBtn" Content="Next" Style="{StaticResource PrimaryButton}"
                            Margin="0,22,0,0" HorizontalAlignment="Right" Click="OnbBtn_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
