<Project Sdk="Microsoft.NET.Sdk">

  <!-- Self-test for the direct-chat face (core/AutoCommand.Agent.Core/DirectChat)
       — the GLM chat client and the chat-side mirror of the bridge's tool
       policy. Everything synthetic: a loopback fake chat/completions server
       scripts canned SSE / JSON responses (and the failure shapes: dead
       socket, mid-stream break, 401, empty answer), and the runner audits
       into a temp data root, so the suite never touches the user's real
       activity log, API key, or the network. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DirectChatSelfTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\AutoCommand.Agent.Core\AutoCommand.Agent.Core.csproj" />
  </ItemGroup>
</Project>
