<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pins the two rules that keep a watcher alive and explain its absence:
       (1) a logon task registered with schtasks' defaults carries PT72H and is
           terminated three days after logon - the 2026-11-08 field report;
       (2) a clean exit deletes heartbeat.json, so a leftover beat with a dead
           pid is proof of an abrupt end, never a false negative.
       Everything synthetic: temp directory, injected pid-alive probe, injected
       attribution probe. The suite never registers a task and never reads the
       live agent directory. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StartupHealthSelfTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ShieldsUp\ShieldsUp.Core\ShieldsUp.Core.csproj" />
    <ProjectReference Include="..\..\core\AutoCommand.Agent.Core\AutoCommand.Agent.Core.csproj" />
  </ItemGroup>

</Project>
