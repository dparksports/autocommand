<Project Sdk="Microsoft.NET.Sdk">

  <!-- Self-test for the block-awareness layers: the 5157 parser and toast
       rate limiter (FirewallDenyWatchService), the impact probe with a
       pinned resolver (BlockImpactProbe), the proxy-hook shapes and
       journal-absent recovery no-op (BlockPageProxyHooks), the domain
       block sync add/rotation/disown/remove lifecycle with fake engine
       seams (DomainBlockSyncService — the ProxyInstallSelfTest §9
       fake-toggle pattern), and the block-page proxy end-to-end
       in-process with a local origin (BlockPageProxyService — hooks OFF,
       TLS CA dir redirected to temp; what runs here is the shipped
       assembly itself, per house convention). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BlockPageSelfTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\AutoCommand.Contain.Core\AutoCommand.Contain.Core.csproj" />
    <ProjectReference Include="..\..\core\AutoCommand.Intercept.Core\AutoCommand.Intercept.Core.csproj" />
  </ItemGroup>
</Project>
