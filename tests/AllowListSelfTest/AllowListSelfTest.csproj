<Project Sdk="Microsoft.NET.Sdk">

  <!-- Self-test for the tamper-evident allow-list ledger (AllowListLedger)
       and the surface-verdict evaluators (SurfaceAssurance), both living in
       the Contain core. Everything synthetic: the ledger root is pointed at
       a temp folder before anything constructs, and no probe touches live
       system state (services, SetupAPI, bcdedit) - the live paths are
       exercised by the app's own enforcement sweeps and need elevation. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AllowListSelfTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\AutoCommand.Contain.Core\AutoCommand.Contain.Core.csproj" />
  </ItemGroup>
</Project>
